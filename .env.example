# Copy to .env (or set as environment variables on your host). NEVER commit real values.
SPRING_PROFILES_ACTIVE=dev

# --- Prod database (MySQL 8) ---
DB_URL=jdbc:mysql://HOST:3306/consultation?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# --- CORS ---
CORS_ORIGINS=https://shwetashete.pages.dev,https://yourdomain.com

# --- Email ---
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Tumcha swatacha Gmail (doctor cha account nako)
MAIL_USERNAME=your.own.gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your.own.gmail@gmail.com
# Patient ne reply kela tar doctor kade jail
MAIL_REPLY_TO=khushishete9075@gmail.com
# Optional: doctor la pratyek email chi BCC copy
MAIL_DOCTOR_BCC=khushishete9075@gmail.com
# Contact form messages ithe yetat (rikame = MAIL_FROM)
CONTACT_TO_EMAIL=khushishete9075@gmail.com

# --- Google Meet ---
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Doctor la pratyek consultation cha calendar invite + Meet link jato
GOOGLE_DOCTOR_EMAIL=khushishete9075@gmail.com
# Keep false: if true, Google emails the Meet link to the patient immediately at booking time.
# The app itself sends the link ~10 minutes before the consultation (REMINDER_MINUTES).
GOOGLE_SEND_INVITES=false
REMINDER_MINUTES=10

# --- WhatsApp Cloud API ---
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_LANG=en
